# Copy to .env.local and fill in. Never commit .env.local.

# Admin sign-in password for /admin. Required for the admin agent.
ADMIN_PASSWORD=

# Store API. Sent server-side as the x-vercel-protection-bypass header.
BYPASS_SECRET=
# Optional. Defaults to https://vercel-agentic-swag-store-api.vercel.app/api
API_BASE_URL=

# Model gateway: "vercel" (default) or "ica".
MODEL_GATEWAY=vercel

# Vercel AI Gateway. On Vercel the OIDC token authenticates.
# Locally, set AI_GATEWAY_API_KEY or pull VERCEL_OIDC_TOKEN with `vercel env pull`.
VERCEL_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_API_KEY=

# ICA gateway (OpenAI-compatible). Only for MODEL_GATEWAY=ica.
ICA_GATEWAY_URL=
ICA_GATEWAY_API_KEY=
ICA_GATEWAY_MODEL=

# Optional. Base name of the admin sandbox. The Vercel environment is appended.
ADMIN_SANDBOX_NAME=

# Optional. Absolute site URL for metadata.
NEXT_PUBLIC_SITE_URL=
